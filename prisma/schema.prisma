generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
}

model SiteSettings {
  id             String   @id @default("main")
  siteTitle      String   @default("MyFolio")
  fullName       String   @default("Your Name")
  headline       String   @default("Full-stack developer")
  intro          String   @default("I build thoughtful digital experiences.")
  about           String   @default("")
  profileImage   String   @default("/images/about-us.jpg")
  resumeUrl      String   @default("")
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  twitterUrl     String   @default("")
  githubUrl      String   @default("")
  linkedinUrl    String   @default("")
  instagramUrl   String   @default("")
  yearsExperience Int     @default(0)
  projectsCount  Int      @default(0)
  clientsCount   Int      @default(0)
  awardsCount    Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("Frontend")
  level     Int      @default(80)
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([visible, sortOrder])
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  role        String
  location    String   @default("")
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([visible, sortOrder])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String   @default("code")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([visible, sortOrder])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String        @default("Web Development")
  summary     String
  description String        @default("")
  imageUrl    String
  liveUrl     String        @default("")
  sourceUrl   String        @default("")
  featured    Boolean       @default(false)
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, featured, sortOrder])
}

model Testimonial {
  id          String        @id @default(cuid())
  name        String
  role        String
  company     String        @default("")
  quote       String
  imageUrl    String        @default("")
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, sortOrder])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  ipHash    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, createdAt])
}
